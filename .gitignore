# Build artifacts
build/
*.o
*.obj
*.a
*.so
*.dll
*.dylib

# Python (tools/)
__pycache__/
*.pyc
*.pyo

# Editor / OS
.vscode/
.idea/
*.swp
*~
.DS_Store

# Local config
conf/*.conf
!conf/*.conf.dist
.claude/

# Test Deck: local config + runtime state + node
testdeck/testdeck.toml
testdeck/.venv/
testdeck/web/node_modules/
testdeck/**/__pycache__/
testdeck/.pytest_cache/
# `pip install -e .` (what CI does, and anyone working on the backend) writes
# its metadata straight into the checkout.
testdeck/*.egg-info/

# TypeScript incremental build cache — a local artifact, not a build output.
testdeck/web/tsconfig.tsbuildinfo
